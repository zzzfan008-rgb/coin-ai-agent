# =============================================================================
# Fashion AI Platform — 环境变量模板
# -----------------------------------------------------------------------------
# 用法:  cp .env.example .env  然后按需修改
# 注意:  .env 已在 .gitignore 中，切勿提交真实密钥！
#
# 地址约定:
#   - 在容器内（docker compose 启动的服务之间）请用服务名: postgres / redis /
#     minio / qdrant / api-core
#   - 在宿主机本地直接运行（go run / cargo run / npm run dev）请用 localhost
# =============================================================================


# ============================== 通用配置 =====================================

# 运行环境: development | staging | production
APP_ENV=development
# 日志级别: trace | debug | info | warn | error
LOG_LEVEL=info


# ============================== PostgreSQL ===================================
# ---- 以下 4 项同时被 docker-compose.yml 使用（创建容器）----
POSTGRES_USER=fashion_ai
POSTGRES_PASSWORD=fashion_ai_dev
POSTGRES_DB=fashion_ai
# 宿主机映射端口（容器内固定 5432）；本机 5432 被占用时可改为 5433
POSTGRES_PORT=5432

# ---- 业务服务连接用 ----
# 容器内访问主机名为 postgres；宿主机本地运行请改为 localhost
DB_HOST=postgres
DB_PORT=5432

# 标准 PostgreSQL 连接串（容器内）
# 宿主机本地运行请改为: postgres://fashion_ai:fashion_ai_dev@localhost:5432/fashion_ai
DATABASE_URL=postgres://fashion_ai:fashion_ai_dev@postgres:5432/fashion_ai
# 最大数据库连接数（按 20 人小团队默认即可）
DB_MAX_CONNECTIONS=10


# ============================== Redis 7 ======================================
# 宿主机映射端口（容器内固定 6379）
REDIS_PORT=6379

# 容器内连接串；宿主机本地运行请改为 redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
# 如需密码: redis://:你的密码@redis:6379/0
#   Phase 1A 运行于 internal 网络，默认不设密码；Phase 1B 再启用 ACL。


# ============================== MinIO 对象存储 ===============================
# ---- 以下 4 项被 docker-compose.yml 使用 ----
# 根账号（生产环境务必修改，密码长度至少 8 位）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# 宿主机映射端口: 9000 = S3 API，9001 = Web 管理控制台
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- 业务服务连接用 ----
# 容器内访问端点；宿主机本地运行请改为 http://localhost:9000
MINIO_ENDPOINT=http://minio:9000
# 管理控制台地址（浏览器打开）: http://localhost:9001
MINIO_CONSOLE_ENDPOINT=http://localhost:9001
# 默认存储桶（首次启动由服务自动创建）
MINIO_BUCKET=fashion-ai
# 是否使用 HTTPS（本地部署默认 false）
MINIO_USE_SSL=false


# ============================== Qdrant 向量库 ================================
# 宿主机映射端口（容器内固定 6333）
QDRANT_PORT=6333

# 容器内访问地址；宿主机本地运行请改为 http://localhost:6333
QDRANT_URL=http://qdrant:6333
# gRPC 端口 6334（容器间使用，默认不对宿主机映射）
QDRANT_GRPC_URL=http://qdrant:6334


# ============================== API 网关（Go）================================
# 网关监听端口
PORT=8080

# JWT 签名密钥（HS256）: 生产环境必须修改，长度不少于 32 字符
# 可用命令生成: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
# JWT 过期时间（小时）
JWT_EXPIRE_HOURS=24

# Rust 核心服务地址（容器内服务名）；宿主机本地运行请改为 http://localhost:8081
RUST_CORE_URL=http://api-core:8081

# 允许跨域来源（前端开发服务器地址）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# ============================== 核心服务（Rust）==============================
# 核心服务监听端口
CORE_PORT=8081


# ============================== LLM 提供方 ===================================
# 按 SPEC 约束，仅本层（核心服务调用 LLM）允许出公网。
# 默认使用的提供方: minimax | deepseek
LLM_PROVIDER=minimax

# ---- MiniMax ----
# 申请地址: https://platform.minimaxi.com/
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
# 默认对话模型（MiniMax-Text-01 为文本模型）
MINIMAX_MODEL=MiniMax-Text-01

# ---- DeepSeek ----
# 申请地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# deepseek-chat 为通用对话模型
DEEPSEEK_MODEL=deepseek-chat

# LLM 请求超时时间（秒）
LLM_TIMEOUT_SECS=120


# ============================== 前端（React）=================================
# 前端调用网关的地址（浏览器端访问，使用宿主机地址）
VITE_API_BASE_URL=http://localhost:8080
# WebSocket 地址（/ws/chat）
VITE_WS_URL=ws://localhost:8080/ws/chat
