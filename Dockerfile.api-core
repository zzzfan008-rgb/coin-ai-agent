# syntax=docker/dockerfile:1
# =============================================================================
# Fashion AI Platform — 核心服务镜像（Rust 1.76）
# -----------------------------------------------------------------------------
# 构建上下文为仓库根目录（不是 api-core/ 目录）:
#   docker build -f Dockerfile.api-core -t fashionai/api-core:latest .
#
# 多阶段构建:
#   builder —— rust:1.76-bookworm 编译 release 二进制
#   runtime —— debian:bookworm-slim 精简运行镜像（非 root 用户运行）
#
# 说明: 二进制名默认取 Cargo.toml 中的包名 api-core。
# =============================================================================

# ----------------------------- builder 阶段 ----------------------------------
FROM rust:1.76-bookworm AS builder

WORKDIR /build

# 先拷贝 Cargo.toml 和 Cargo.lock 并用占位 main.rs 预编译依赖，利用 Docker 层缓存
COPY api-core/Cargo.toml ./
COPY api-core/Cargo.lock ./
RUN mkdir -p src \
    && echo 'fn main() {}' > src/main.rs \
    # 预拉取并编译所有依赖（失败也继续，无依赖时这一步本就为空）
    && (cargo build --release || true)

# 拷贝真实源码，触碰 main.rs 使 cargo 重新编译业务代码
COPY api-core/src ./src
RUN touch src/main.rs && cargo build --release
# 去除调试符号（单独一步，失败不掩盖编译错误）
RUN strip target/release/api-core 2>/dev/null || true

# ----------------------------- runtime 阶段 ----------------------------------
FROM debian:bookworm-slim AS runtime

# ca-certificates: 调用 LLM API 的 HTTPS；curl: 健康检查
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --user-group appuser

WORKDIR /app

COPY --from=builder /build/target/release/api-core /app/api-core

USER appuser

# 核心服务监听端口（与 CORE_PORT 环境变量默认值一致）
EXPOSE 8081

# 容器级健康检查（核心服务实现 /health 端点，见 T-005 规格）
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8081/health || exit 1

ENTRYPOINT ["/app/api-core"]
